{
  "name": "stevin-ai-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "indexnow": "npx tsx scripts/indexnow.ts",
    "validate:schema": "npx tsx scripts/validate-jsonld.ts",
    "faq:generate": "npx tsx scripts/generate-faqs.ts",
    "related:generate": "npx tsx scripts/generate-related.ts",
    "journal:audit": "npx tsx scripts/audit-journal-content.ts",
    "check:header": "npx tsx scripts/check-header-contrast.ts",
    "check:header-lock": "npx tsx scripts/check-header-lock.ts",
    "check:boeking-lock": "npx tsx scripts/check-boeking-lock.ts",
    "check:snelheid": "npx tsx scripts/check-snelheid.ts",
    "postbuild": "npx tsx scripts/check-snelheid.ts --html",
    "check:sitemap": "npx tsx scripts/check-sitemap-canonicals.ts",
    "check:sitemap:structuur": "npx tsx scripts/check-sitemap-structuur.ts",
    "verify:production": "npx tsx scripts/verify-production-release.ts",
    "prebuild": "npx tsx scripts/check-header-lock.ts && npx tsx scripts/check-boeking-lock.ts && npx tsx scripts/check-snelheid.ts && npx tsx scripts/generate-related.ts && npx tsx scripts/check-sitemap-structuur.ts && npx tsx scripts/audit-journal-content.ts --check && npx tsx scripts/check-php-check.ts",
    "check:copy": "npx tsx scripts/check-copy.ts",
    "check:php-check": "npx tsx scripts/check-php-check.ts"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "next": "^16.3.8",
    "next-intl": "^4.9.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.4"
  }
}
