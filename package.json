    "vendor:enrich": "npx tsx scripts/generate-vendor-enrichments.ts",
    "check:header": "npx tsx scripts/check-header-contrast.ts",
    "check:sitemap": "npx tsx scripts/check-sitemap-canonicals.ts",
    "check:sitemap:structuur": "npx tsx scripts/check-sitemap-structuur.ts",
    "verify:production": "npx tsx scripts/verify-production-release.ts",
